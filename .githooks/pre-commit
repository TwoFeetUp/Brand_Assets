#!/usr/bin/env node

/**
 * TwoFeetUp Brand Assets — pre-commit hook
 *
 * Blokkeert commits die niet voldoen aan de naamgevings- en manifest-regels.
 * Zie CLAUDE.md voor de volledige regels.
 */

const { execSync } = require("child_process");
const fs = require("fs");
const path = require("path");

execSync("gitleaks git --staged --no-banner -v", { stdio: "inherit" });

const IMAGE_DUMP_PREFIX = "image_dump/";
const IMAGE_DUMP_INDEX = "image_dump/index.json";
const VIDEO_DUMP_PREFIX = "video_dump/";
const VIDEO_DUMP_INDEX = "video_dump/index.json";
const GITHUB_FILE_SIZE_LIMIT = 100 * 1024 * 1024; // 100MB hard cap on github.com

// ─── Staged bestanden ophalen ──────────────────────────────────────────────────

function getStagedFiles() {
  const output = execSync("git diff --cached --name-status", { encoding: "utf8" });
  return output
    .trim()
    .split("\n")
    .filter(Boolean)
    .map((line) => {
      const parts = line.split("\t");
      return { status: parts[0], file: parts[parts.length - 1] };
    });
}

let staged = getStagedFiles();
const errors = [];

const MEDIA_EXTS = [".jpg", ".jpeg", ".png", ".webp", ".gif", ".svg", ".mp4", ".mov", ".avi", ".mkv", ".m4v"];

// ─── image_dump/index.json automatisch (her)genereren ─────────────────────────
// Doel: image_dump/ is bewust uitgesloten van manifest.json om bloat te voorkomen.
// Consumers vinden de inhoud via een aparte, auto-gegenereerde index. Zie CLAUDE.md.

const stagedImageDumpChanges = staged.filter(
  (f) => f.file.startsWith(IMAGE_DUMP_PREFIX) && f.file !== IMAGE_DUMP_INDEX
);

if (stagedImageDumpChanges.length > 0) {
  const tracked = execSync("git ls-files --cached image_dump/", { encoding: "utf8" })
    .trim()
    .split("\n")
    .filter(Boolean)
    .filter((f) => f !== IMAGE_DUMP_INDEX)
    .filter((f) => MEDIA_EXTS.includes(path.extname(f).toLowerCase()));

  const indexEntries = tracked.sort().map((file) => ({
    path: "/" + file,
    name: path.basename(file, path.extname(file)),
  }));

  const newContent = JSON.stringify(indexEntries, null, 2) + "\n";
  const previous = fs.existsSync(IMAGE_DUMP_INDEX) ? fs.readFileSync(IMAGE_DUMP_INDEX, "utf8") : null;

  if (previous !== newContent) {
    fs.writeFileSync(IMAGE_DUMP_INDEX, newContent);
    execSync(`git add ${IMAGE_DUMP_INDEX}`);
    console.log(`ℹ️   ${IMAGE_DUMP_INDEX} geregenereerd (${indexEntries.length} entries) en gestaged.`);
    staged = getStagedFiles();
  }
}

// ─── video_dump/index.json automatisch (her)genereren ─────────────────────────
// Zelfde patroon als image_dump/, ook bewust uitgesloten van manifest.json.

const stagedVideoDumpChanges = staged.filter(
  (f) => f.file.startsWith(VIDEO_DUMP_PREFIX) && f.file !== VIDEO_DUMP_INDEX
);

if (stagedVideoDumpChanges.length > 0) {
  const trackedVideos = execSync("git ls-files --cached video_dump/", { encoding: "utf8" })
    .trim()
    .split("\n")
    .filter(Boolean)
    .filter((f) => f !== VIDEO_DUMP_INDEX)
    .filter((f) => MEDIA_EXTS.includes(path.extname(f).toLowerCase()));

  const videoIndexEntries = trackedVideos.sort().map((file) => ({
    path: "/" + file,
    name: path.basename(file, path.extname(file)),
  }));

  const newVideoIndex = JSON.stringify(videoIndexEntries, null, 2) + "\n";
  const previousVideoIndex = fs.existsSync(VIDEO_DUMP_INDEX) ? fs.readFileSync(VIDEO_DUMP_INDEX, "utf8") : null;

  if (previousVideoIndex !== newVideoIndex) {
    fs.writeFileSync(VIDEO_DUMP_INDEX, newVideoIndex);
    execSync(`git add ${VIDEO_DUMP_INDEX}`);
    console.log(`ℹ️   ${VIDEO_DUMP_INDEX} geregenereerd (${videoIndexEntries.length} entries) en gestaged.`);
    staged = getStagedFiles();
  }
}

const newFiles = staged.filter((f) => f.status === "A");
const manifestUpdated = staged.some((f) => f.file === "manifest.json");

// image_dump/ en video_dump/ vallen expliciet buiten de "elke upload = manifest entry"-regel.
const newMediaFiles = newFiles.filter(
  (f) =>
    MEDIA_EXTS.includes(path.extname(f.file).toLowerCase()) &&
    !f.file.startsWith(IMAGE_DUMP_PREFIX) &&
    !f.file.startsWith(VIDEO_DUMP_PREFIX)
);

// ─── Regel 1: manifest.json moet bijgewerkt zijn bij nieuwe mediabestanden ─────

if (newMediaFiles.length > 0 && !manifestUpdated) {
  errors.push({
    rule: "MANIFEST_NOT_UPDATED",
    message: `${newMediaFiles.length} nieuw(e) mediabestand(en) toegevoegd, maar manifest.json is niet bijgewerkt.`,
    files: newMediaFiles.map((f) => `  - ${f.file}`),
    fix: "Voeg voor elk nieuw bestand een entry toe aan manifest.json (path, name, description, uploadedAt).",
  });
}

// ─── Regel 2: edited/ bestanden moeten beschrijvende snake_case namen hebben ──

const CAMERA_PATTERN = /^(img|dsc|dscn|p|pic|photo|video|mov|vlc|whatsapp|screenshot)[-_]/i;
const TIMESTAMP_ONLY = /^\d{8}[-_]\d{6}/;
const SNAKE_CASE_MIN2 = /^[a-z][a-z0-9]*(_[a-z0-9]+)+$/;

newFiles
  .filter((f) => f.file.startsWith("edited/"))
  .forEach((f) => {
    const basename = path.basename(f.file, path.extname(f.file));
    const ext = path.extname(f.file).toLowerCase();

    if (ext !== ".webp") {
      errors.push({
        rule: "EDITED_MUST_BE_WEBP",
        message: `Bestand in edited/ moet .webp zijn: ${f.file}`,
        fix: "Converteer naar WebP vóór upload naar edited/.",
      });
    }

    if (CAMERA_PATTERN.test(basename) || TIMESTAMP_ONLY.test(basename)) {
      errors.push({
        rule: "EDITED_CAMERA_NAME",
        message: `Cameranaam niet toegestaan in edited/: ${f.file}`,
        fix: `Hernoem naar beschrijvende naam, bijv: workshop_team_demo.webp`,
      });
    } else if (!SNAKE_CASE_MIN2.test(basename)) {
      errors.push({
        rule: "EDITED_NAME_FORMAT",
        message: `Naam voldoet niet aan snake_case (minimaal 2 woorden): ${f.file}`,
        fix: `Gebruik: woord_woord_woord.webp — bijv: hackathon_keynote_spreker.webp`,
      });
    }
  });

// ─── Regel 3: images/external/ moet naamconventie volgen ──────────────────────

newFiles
  .filter((f) => f.file.startsWith("images/external/"))
  .forEach((f) => {
    const basename = path.basename(f.file);
    if (!/^external_[A-Za-z]+_[A-Za-z]/.test(basename)) {
      errors.push({
        rule: "EXTERNAL_NAME_FORMAT",
        message: `Bestand in images/external/ volgt naamconventie niet: ${f.file}`,
        fix: `Gebruik: external_[Naam]_[Organisatie].[ext] — bijv: external_Anna_Bakker_Accenture.jpg`,
      });
    }
  });

// ─── Regel 3b: video_dump/ — MP4-only, max 100MB, snake_case ─────────────────

const VIDEO_EXTS = [".mp4", ".mov", ".avi", ".mkv", ".m4v", ".webm"];

newFiles
  .filter((f) => f.file.startsWith(VIDEO_DUMP_PREFIX))
  .forEach((f) => {
    const ext = path.extname(f.file).toLowerCase();
    const basename = path.basename(f.file, path.extname(f.file));
    const isMedia = MEDIA_EXTS.includes(ext);
    const isVideo = VIDEO_EXTS.includes(ext);

    // README.md / index.json mogen door
    if (!isMedia) return;

    // Alleen video's verwacht in video_dump/
    if (!isVideo) {
      errors.push({
        rule: "VIDEO_DUMP_NOT_A_VIDEO",
        message: `Niet-video bestand in video_dump/: ${f.file}`,
        fix: "Plaats afbeeldingen in image_dump/, niet in video_dump/.",
      });
      return;
    }

    // MP4-only
    if (ext !== ".mp4") {
      errors.push({
        rule: "VIDEO_DUMP_NOT_MP4",
        message: `Alleen .mp4 toegestaan in video_dump/: ${f.file}`,
        fix: `Converteer naar MP4 (H.264 + AAC):\n     ffmpeg -i "${f.file}" -c:v libx264 -pix_fmt yuv420p -movflags +faststart -c:a aac -b:a 128k output.mp4`,
      });
    }

    // Naamgeving
    if (CAMERA_PATTERN.test(basename) || TIMESTAMP_ONLY.test(basename)) {
      errors.push({
        rule: "VIDEO_DUMP_CAMERA_NAME",
        message: `Cameranaam niet toegestaan in video_dump/: ${f.file}`,
        fix: "Hernoem naar beschrijvende snake_case naam, bijv: demo_dashboard_walkthrough.mp4",
      });
    } else if (!SNAKE_CASE_MIN2.test(basename)) {
      errors.push({
        rule: "VIDEO_DUMP_NAME_FORMAT",
        message: `Naam voldoet niet aan snake_case (minimaal 2 woorden): ${f.file}`,
        fix: "Gebruik: woord_woord_woord.mp4 — bijv: teaser_30s_hackathon.mp4",
      });
    }

    // 100MB GitHub harde limiet
    try {
      const size = fs.statSync(f.file).size;
      if (size > GITHUB_FILE_SIZE_LIMIT) {
        const mb = (size / (1024 * 1024)).toFixed(1);
        errors.push({
          rule: "VIDEO_DUMP_TOO_LARGE",
          message: `Bestand te groot voor GitHub (${mb}MB > 100MB): ${f.file}`,
          fix: `Trim of comprimeer met ffmpeg, of host op YouTube/Vimeo en embed die i.p.v. de file zelf:\n     ffmpeg -i "${f.file}" -c:v libx264 -crf 28 -preset slow -movflags +faststart -c:a aac -b:a 96k smaller.mp4`,
        });
      }
    } catch (_) {
      /* file niet meer aanwezig op disk; skip */
    }
  });

// ─── Regel 4: raw/ bestanden mogen geen puur UUID-formaat hebben ──────────────

const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i;

newFiles
  .filter((f) => f.file.startsWith("raw/"))
  .forEach((f) => {
    const basename = path.basename(f.file, path.extname(f.file));
    if (UUID_PATTERN.test(basename)) {
      errors.push({
        rule: "RAW_UUID_NAME",
        message: `UUID-bestandsnaam niet toegestaan: ${f.file}`,
        fix: `Hernoem naar iets leesbaars, zelfs in raw/ — bijv: zomerkamp_groepsfoto.jpg`,
      });
    }
  });

// ─── Output ────────────────────────────────────────────────────────────────────

if (errors.length > 0) {
  console.error("\n❌  Commit geblokkeerd — Brand Assets regels overtreden\n");
  console.error("─".repeat(60));

  errors.forEach((err, i) => {
    console.error(`\n${i + 1}. [${err.rule}]`);
    console.error(`   ${err.message}`);
    if (err.files) {
      err.files.forEach((f) => console.error(`   ${f}`));
    }
    console.error(`   ✏️  Fix: ${err.fix}`);
  });

  console.error("\n" + "─".repeat(60));
  console.error("📖  Alle regels: zie CLAUDE.md in de root van deze repo");
  console.error("    https://github.com/TwoFeetUp/Brand_Assets/blob/main/CLAUDE.md\n");
  process.exit(1);
}

process.exit(0);
